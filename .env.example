ENVIRONMENT=development
ENABLE_MOCK_REWARDS=false
# Set these from your Supabase PostgreSQL project connection details.
# DATABASE_URL: SQLAlchemy/psycopg URL, commonly the Supabase transaction pooler URL.
# DIRECT_URL: optional direct/session pooler URL for Alembic migrations.
DATABASE_URL=
DIRECT_URL=
# Redis is not required by the current API; leave unset for local development.
REDIS_URL=
SECRET_KEY=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret
WITHDRAWAL_ENCRYPTION_KEY=
WITHDRAWAL_MINIMUM_AMOUNT=5.00
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_ORIGIN=http://localhost:3000
LOOTABLY_API_KEY=
LOOTABLY_PLACEMENT_ID=
LOOTABLY_POSTBACK_SECRET=
ADGEM_API_KEY=
ADGEM_APP_ID=
ADGEM_POSTBACK_SECRET=
CPALEAD_API_KEY=
CPALEAD_PUBLISHER_ID=
CPALEAD_POSTBACK_SECRET=
OFFERWALL_GG_API_KEY=
OFFERWALL_GG_POSTBACK_SECRET=
MONLIX_API_KEY=
MONLIX_POSTBACK_SECRET=
BITLABS_API_KEY=
BITLABS_POSTBACK_SECRET=
ADGATE_API_KEY=
ADGATE_POSTBACK_SECRET=
TOROX_API_KEY=
TOROX_POSTBACK_SECRET=
ADSWEDMEDIA_API_KEY=
ADSWEDMEDIA_POSTBACK_SECRET=
REVU_API_KEY=
REVU_POSTBACK_SECRET=
# Supported values: resend, brevo
EMAIL_PROVIDER=brevo
# Create a Brevo API key from Settings > SMTP & API > API keys.
EMAIL_API_KEY=
# Register and verify this sender in Brevo before sending email.
EMAIL_FROM_ADDRESS=WorkBit <mhmunir.dev@gmail.com>
EMAIL_VERIFICATION_OTP_TTL_MINUTES=10
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
