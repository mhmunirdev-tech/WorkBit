FROM node:22-alpine
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_AMANAHADS_INSTANCE_KEY
ENV NEXT_PUBLIC_AMANAHADS_INSTANCE_KEY=$NEXT_PUBLIC_AMANAHADS_INSTANCE_KEY
ARG NEXT_PUBLIC_AADS_ENABLED
ENV NEXT_PUBLIC_AADS_ENABLED=$NEXT_PUBLIC_AADS_ENABLED
ARG NEXT_PUBLIC_AADS_UNIT_ID
ENV NEXT_PUBLIC_AADS_UNIT_ID=$NEXT_PUBLIC_AADS_UNIT_ID
ARG NEXT_PUBLIC_AADS_UNIT_SIZE
ENV NEXT_PUBLIC_AADS_UNIT_SIZE=$NEXT_PUBLIC_AADS_UNIT_SIZE
ARG NEXT_PUBLIC_COINZILLA_ENABLED
ENV NEXT_PUBLIC_COINZILLA_ENABLED=$NEXT_PUBLIC_COINZILLA_ENABLED
ARG NEXT_PUBLIC_COINZILLA_ZONE_ID
ENV NEXT_PUBLIC_COINZILLA_ZONE_ID=$NEXT_PUBLIC_COINZILLA_ZONE_ID
ARG NEXT_PUBLIC_COINTRAFFIC_ENABLED
ENV NEXT_PUBLIC_COINTRAFFIC_ENABLED=$NEXT_PUBLIC_COINTRAFFIC_ENABLED
ARG NEXT_PUBLIC_COINTRAFFIC_TAG_SRC
ENV NEXT_PUBLIC_COINTRAFFIC_TAG_SRC=$NEXT_PUBLIC_COINTRAFFIC_TAG_SRC
ARG NEXT_PUBLIC_COINTRAFFIC_ZONE_ID
ENV NEXT_PUBLIC_COINTRAFFIC_ZONE_ID=$NEXT_PUBLIC_COINTRAFFIC_ZONE_ID
ARG NEXT_PUBLIC_PROPELLERADS_ENABLED
ENV NEXT_PUBLIC_PROPELLERADS_ENABLED=$NEXT_PUBLIC_PROPELLERADS_ENABLED
ARG NEXT_PUBLIC_PROPELLERADS_TAG_SRC
ENV NEXT_PUBLIC_PROPELLERADS_TAG_SRC=$NEXT_PUBLIC_PROPELLERADS_TAG_SRC
ARG NEXT_PUBLIC_PROPELLERADS_ZONE_ID
ENV NEXT_PUBLIC_PROPELLERADS_ZONE_ID=$NEXT_PUBLIC_PROPELLERADS_ZONE_ID
ARG NEXT_PUBLIC_MONETAG_ENABLED
ENV NEXT_PUBLIC_MONETAG_ENABLED=$NEXT_PUBLIC_MONETAG_ENABLED
ARG NEXT_PUBLIC_MONETAG_TAG_SRC
ENV NEXT_PUBLIC_MONETAG_TAG_SRC=$NEXT_PUBLIC_MONETAG_TAG_SRC
ARG NEXT_PUBLIC_MONETAG_ZONE_ID
ENV NEXT_PUBLIC_MONETAG_ZONE_ID=$NEXT_PUBLIC_MONETAG_ZONE_ID
ARG NEXT_PUBLIC_BITMEDIA_ENABLED
ENV NEXT_PUBLIC_BITMEDIA_ENABLED=$NEXT_PUBLIC_BITMEDIA_ENABLED
ARG NEXT_PUBLIC_BITMEDIA_PLACEMENT_ID
ENV NEXT_PUBLIC_BITMEDIA_PLACEMENT_ID=$NEXT_PUBLIC_BITMEDIA_PLACEMENT_ID
ARG NEXT_PUBLIC_BITMEDIA_WIDTH
ENV NEXT_PUBLIC_BITMEDIA_WIDTH=$NEXT_PUBLIC_BITMEDIA_WIDTH
ARG NEXT_PUBLIC_BITMEDIA_HEIGHT
ENV NEXT_PUBLIC_BITMEDIA_HEIGHT=$NEXT_PUBLIC_BITMEDIA_HEIGHT
ARG NEXT_PUBLIC_PROFITON_DOMAIN_VERIFICATION
ENV NEXT_PUBLIC_PROFITON_DOMAIN_VERIFICATION=$NEXT_PUBLIC_PROFITON_DOMAIN_VERIFICATION
COPY package.json ./
RUN npm install
COPY . .
RUN npm run build
EXPOSE 3000
CMD ["npm", "start"]
