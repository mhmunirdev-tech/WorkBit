FROM node:22-alpine
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_AMANAHADS_INSTANCE_KEY
ENV NEXT_PUBLIC_AMANAHADS_INSTANCE_KEY=$NEXT_PUBLIC_AMANAHADS_INSTANCE_KEY
ARG NEXT_PUBLIC_AADS_ENABLED
ENV NEXT_PUBLIC_AADS_ENABLED=$NEXT_PUBLIC_AADS_ENABLED
ARG NEXT_PUBLIC_AADS_UNIT_ID
ENV NEXT_PUBLIC_AADS_UNIT_ID=$NEXT_PUBLIC_AADS_UNIT_ID
ARG NEXT_PUBLIC_AADS_UNIT_SIZE
ENV NEXT_PUBLIC_AADS_UNIT_SIZE=$NEXT_PUBLIC_AADS_UNIT_SIZE
COPY package.json ./
RUN npm install
COPY . .
RUN npm run build
EXPOSE 3000
CMD ["npm", "start"]
